    {
      "id": "BILLING_INFO",
      "title": "Billing Information",
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Billing & Tax Details"
          },
          {
            "type": "TextInput",
            "label": "Invoice Number",
            "name": "invoice_number",
            "required": true,
            "input-type": "text",
            "helper-text": "e.g. INV-001"
          },
          {
            "type": "DatePicker",
            "label": "Invoice Date",
            "name": "invoice_date",
            "required": true
