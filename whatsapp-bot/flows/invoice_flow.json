            "type": "DatePicker",
            "label": "Due Date",
            "name": "due_date",
            "required": true
          },
          {
            "type": "Dropdown",
            "label": "Currency",
            "name": "currency",
            "required": true,
            "data-source": [
              { "id": "USD", "title": "USD - US Dollar" },
              { "id": "ZWL", "title": "ZWL - Zimbabwe Dollar" },
              { "id": "ZAR", "title": "ZAR - South African Rand" },
              { "id": "GBP", "title": "GBP - British Pound" },
              { "id": "EUR", "title": "EUR - Euro" }
            ]
          },
          {
            "type": "TextInput",
            "label": "Tax / VAT Number",
            "name": "tax_number",
            "required": false,
            "input-type": "text",
            "helper-text": "Optional"
          },
          {
            "type": "TextInput",
            "label": "Tax Rate (%)",
            "name": "tax_rate",
            "required": false,
            "input-type": "number",
            "helper-text": "Enter 0 if no tax applies"
          },
          {
