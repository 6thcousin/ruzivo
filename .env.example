# ── WhatsApp Cloud API ─────────────────────────────────────────────────────────
WHATSAPP_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
VERIFY_TOKEN=my_secret_verify_token

# ── WhatsApp Flows (optional until Business Verification is complete) ──────────
FLOW_ID=your_flow_id_here
FLOW_MODE=draft        # "draft" while testing, "published" after going live

# ── Meta Commerce Catalog ──────────────────────────────────────────────────────
CATALOG_ID=2713236235697960

# ── App ────────────────────────────────────────────────────────────────────────
BASE_URL=https://your-ngrok-url.ngrok.io
API_VERSION=v19.0

# ── WireGuard VPN (VPS peer management) ───────────────────────────────────────
WG_INTERFACE=wg0
WG_SUBNET=10.0.0.0/24
WG_SERVER_IP=your_vps_public_ip_or_domain
WG_SERVER_PORT=51820
WG_SERVER_PUBKEY=your_server_wireguard_public_key
# Path where registered peer metadata is stored (JSON)
WG_PEERS_FILE=/etc/wireguard/ruzivo_peers.json
